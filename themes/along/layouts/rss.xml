{{- $pages := .RegularPages -}}
{{- if .IsHome -}}
  {{- $pages = where site.RegularPages "Section" "in" (slice "writing" "projects") -}}
{{- else if eq .Kind "section" -}}
  {{- $pages = .RegularPagesRecursive -}}
{{- end -}}
{{- $pages = first 20 $pages.ByDate.Reverse -}}
{{- $feedURL := .Permalink -}}
{{- with .OutputFormats.Get "RSS" }}{{ $feedURL = .Permalink }}{{ end -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safe.HTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if .IsHome }}{{ site.Title }}{{ else }}{{ .Title }} · {{ site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Description | default site.Params.description }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale }}</language>
    <atom:link href="{{ $feedURL }}" rel="self" type="application/rss+xml" />
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Description | default (.Summary | plainify) | transform.XMLEscape }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
