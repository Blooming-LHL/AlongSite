{
  "name": "along-site",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.17.0" },
  "scripts": {
    "content:check": "node scripts/publish-content.mjs --check",
    "content:dry-run": "node scripts/publish-content.mjs --dry-run",
    "content:sync": "node scripts/publish-content.mjs --write",
    "dev": "hugo server --buildDrafts --disableFastRender",
    "build:hugo": "hugo --gc --minify",
    "build": "npm run build:hugo",
    "test": "node --test"
  },
  "dependencies": { "yaml": "2.9.1" }
}
